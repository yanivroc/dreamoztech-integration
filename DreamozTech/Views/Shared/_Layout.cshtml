@model DisplayViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    @* Google Webmaster Validation *@  
    @* <meta name="google-site-verification" content="FCEzY2sZjTfnjne5vhEkkxV-k0wj4o0vYmv-6PFiNa8" /> *@ 
    @* Bing Webmaster Validation *@
    @* <meta name="msvalidate.01" content="89274D06F4428E6B28565F32D4FE470A" /> *@
    <title>@Model.MemberFullName</title>
    <meta name="description" content="@Model.CurrentPage.SeoDescription">
    <meta name="keywords" content="@Model.CurrentPage.SeoKeywords">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="@Model.MemberDetailObject.Website" />
    <meta property="og:title" content="@Model.CurrentPage.PageTitle">
    <meta property="og:description" content="@Model.CurrentPage.Description">
    <meta property="og:image" content="@Model.MemberLogoImagePath">
    <meta property="og:url" content="@Model.MemberDetailObject.Website">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="@Model.MemberLogoImagePath">
    <meta name="twitter:site" content="@Model.MemberDetailObject.FacebookProfile">
    <meta name="twitter:title" content="@Model.CurrentPage.PageTitle">
    <meta name="twitter:description" content="@Model.CurrentPage.Description">
    <meta name="twitter:image" content="@Model.MemberLogoImagePath">
    <link rel="icon" type="image/x-icon" href="@Model.MemberFaviconPath" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- Tailwind CSS CDN - Added for direct use of Tailwind classes -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script type="text/javascript" src="https://sandbox.web.squarecdn.com/v1/square.js"></script>
    @* <script type="text/javascript" src="https://web.squarecdn.com/v1/square.js"></script> *@
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script async defer src="https://maps.googleapis.com/maps/api/js?key=@Model.GoogleMapKey&callback=initAutocomplete"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- Google tag (gtag.js) -->
    @* <script async src="https://www.googletagmanager.com/gtag/js?id=G-MW690EDNSD"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-MW690EDNSD');
    </script> *@
    @await RenderSectionAsync("Scripts", required: false)
</head>
<body>
    <header>
        <input type="hidden" id="application-id" value="@Model.ApplicationId">
        <input type="hidden" id="location-id" value="@Model.LocationId">
        <h1><a href="/"> <img src="@Model.MemberLogoImagePath" alt="@Model.MemberFullName" class="header-logo"></a></h1>
        <button class="hamburger-menu" aria-label="Open navigation menu">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </button>
        <nav id="mainNav">
            <button class="close-menu-btn" aria-label="Close menu">&times;</button>
            @foreach (var item in @Model.MenuItems)
            {
                <a href="#@item.Http">@item.Title</a>
            }
            <a href="#Cart" aria-label="Shopping Cart">
                <i class="fas fa-shopping-cart"></i>
                <span id="cart-item-count" class="cart-count">0</span>
            </a>
            <a href="@Model.MemberDetailObject.FacebookProfile" target="_blank" aria-label="Facebook">
                <i class="fab fa-facebook-f"></i>
            </a>
            <a href="@Model.MemberDetailObject.InstagramProfile" target="_blank" aria-label="Instagram">
                <i class="fab fa-instagram"></i>
            </a>
        </nav>
    </header>

    <section id="Home" class="hero-slider">
        <div class="slides-container">
            @{
                int slideIndex = 0;
                foreach (var pic in Model.SliderPics.OrderBy(p => p.DisplayOrder))
                {
                    <div class="slide @(slideIndex == 0 ? "active" : "")"
                         style="background-image: url('@(pic.PicPath)');" title="@Model.HomePage.PageTitle">
                        <h2>@pic.PicDescription</h2>
                    </div>
                    slideIndex++;
                }
            }
        </div>
        <button class="prev-button">&#10094;</button>
        <button class="next-button">&#10095;</button>
        <div class="dots-container">
            @{
                int slideIndexDot = 0;
            }
            @foreach (var pic in Model.SliderPics.OrderBy(p => p.DisplayOrder))
            {
                <span class="dot @(slideIndexDot == 0 ? "active" : "")" data-slide-index="@slideIndexDot"></span>
                slideIndexDot++;
            }
        </div>
    </section>

    <div class="container bg-white py-8 px-4 sm:px-6 lg:px-8 rounded-xl shadow-lg max-w-4xl mx-auto my-8 font-semibold">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <section id="Cart">
        <!-- Main Content Area - Shopping Cart -->
        <main class="p-4 sm:p-6 lg:p-8 bg-gray-50 min-h-screen">
            <h1 class="text-3xl sm:text-4xl font-bold text-center text-gray-800 mb-8 custom-h1">Start Shopping Now!</h1>

            <!-- Cart Content Container -->
            <div id="cart-content-container" class="max-w-5xl mx-auto">
                <!-- Cart items table will be injected here by JavaScript -->
            </div>

            <!-- Summary and Checkout Section wrapped in a <form> -->
            <form id="checkout-form" class="cart-summary-section" action="/Newsletter/pay" onsubmit="return processPayment(event)">
                <!-- Summary and Checkout Section -->
                <div class="cart-summary-section">
                    <!-- Centered summary -->
                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span id="subtotal-amount">$0.00</span>
                    </div>
                    <div class="summary-row delivery-option">
                        <label for="delivery-checkbox">
                            Delivery
                            <input type="checkbox" id="delivery-checkbox">
                        </label>
                        <span id="delivery-amount" style="display: none;">$0.00</span>
                    </div>
                    <div class="summary-row total">
                        <span>Total</span>
                        <span id="total-amount">$0.00</span>
                    </div>
                    <div class="customer-info-fields">
                        <h3 class="payment-heading">Your Details</h3>
                        <div class="form-row">
                            <label for="customer-name">Name:</label>
                            <input type="text" id="customer-name" placeholder="Enter your full name" required maxlength="30">
                        </div>
                        <div class="form-row">
                            <label for="customer-phone">Phone:</label>
                            <input type="tel" id="customer-phone" placeholder="Enter your phone number" required maxlength="20">
                        </div>
                        <div class="form-row">
                            <label for="customer-email">Email:</label>
                            <input type="email" id="customer-email" placeholder="Enter your email address" required maxlength="30">
                        </div>
                        <div class="form-row">
                            <label for="customer-address">Address:</label>
                            <input type="text" id="customer-address" placeholder="Start typing your address" required>
                            <p class="address-helper-text">Powered by Google Maps</p>
                        </div>
                        <div class="form-row">
                            <label for="customer-notes">Notes (optional):</label>
                            <textarea id="customer-notes" rows="3" placeholder="Add any special instructions or notes"></textarea>
                        </div>
                    </div>
                    <!-- Credit/Debit Card Fields -->
                    <div class="payment-info-fields">
                        <h3 class="payment-heading">Payment Information</h3>
                        <div class="form-row">
                            <label for="sq-card-number">Card Details:</label>
                            <div id="card-container"></div> <!-- Square will inject the card input here -->
                        </div>
                    </div>
                    <!-- THIS IS THE SEPARATE CONTAINER FOR THE CARD LEGEND -->
                    <div class="accepted-cards-legend">
                        <span class="legend-text">Accepted Cards:</span>
                        <div class="card-icons-list">
                            <!-- Visa -->
                            <i class="fa-brands fa-cc-visa card-icon" title="Visa"></i>
                            <!-- Mastercard -->
                            <i class="fa-brands fa-cc-mastercard card-icon" title="Mastercard"></i>
                            <!-- American Express -->
                            <i class="fa-brands fa-cc-amex card-icon" title="American Express"></i>
                            <!-- Discover -->
                            <i class="fa-brands fa-cc-discover card-icon" title="Discover"></i>
                            <!-- JCB -->
                            <i class="fa-brands fa-cc-jcb card-icon" title="JCB"></i>
                            <!-- eftpos (Australian specific, using generic card icon) -->
                            <i class="fa-solid fa-credit-card card-icon" title="Eftpos"></i>
                        </div>
                    </div>
                    <!-- reCAPTCHA widget -->
                    <div class="form-row">
                        <div class="g-recaptcha" data-sitekey="@Model.SiteKey" data-callback="recaptchaCompletedPayment"></div>
                    </div>

                    <!-- Pay Button -->
                    <button type="submit" id="pay-button" class="btn btn-checkout">Complete Your Order</button>
                </div>
            </form>
        </main>
    </section>

    <section id="Products" class="products">
        @foreach (var item in Model.ProductList)
        {
            var itemPrice = item.Attributes.FirstOrDefault(x => x.Title == "price").Value;
            var itemMinQuantity = item.Attributes.FirstOrDefault(x => x.Title == "minquantity").Value;
            var itemMaxQuantity = item.Attributes.FirstOrDefault(x => x.Title == "maxquantity").Value;
            var itemImage = item.Pics.OrderBy(x => x.DisplayOrder).FirstOrDefault();
            var itemImageUrl = new Uri(itemImage.PicPath);
            double productPrice = double.Parse(itemPrice);
            if (productPrice > 0)
            {
                <div class="product">
                    <a href="/@item.BizDisplayTitle"><img src="@itemImageUrl" alt="@item.BizName" /></a>
                    <h3><a href="/@item.BizDisplayTitle">@item.BizName</a></h3>
                    <p class="item-price py-4">@itemPrice AUD</p>
                    <button class="add-to-cart-btn w-full bg-green-500 text-white py-4 px-4 rounded-md hover:bg-green-600 transition duration-300" onclick="addToCart('@item.BizName', @itemPrice, '@item.BizDisplayTitle', '@itemImageUrl', @itemMinQuantity, @itemMaxQuantity)">Add to Cart</button>
                </div>
            }
        }
    </section>

    <section id="About" class="section-container bg-white py-8 px-4 sm:px-6 lg:px-8 rounded-xl shadow-lg">
        <div class="section-content max-w-4xl mx-auto">
            <!-- Flex container for text and image. Stacks vertically on small screens (flex-col) and becomes a row on medium screens and larger (md:flex-row). -->
            <div class="flex flex-col md:flex-row md:items-start md:space-x-8">
                <!-- Text content on the left. Ensure it takes full width on mobile and can shrink. -->
                <div class="w-full md:w-1/2 mb-6 md:mb-0 min-w-0">
                    <h2 class="text-3xl font-bold text-orange-700 mb-4 text-center md:text-left">@Model.AboutPage.PageTitle</h2>
                    <p class="text-lg leading-relaxed mb-6 text-gray-700 text-center md:text-left">
                        @Html.Raw(Model.AboutPage.Description)
                    </p>
                </div>
                @{
                    var itemImages = Model.AboutPage.Posts.FirstOrDefault(x => x.PostType == "About");
                    if (itemImages != null)
                    {
                        var itemImage = itemImages.Pics.FirstOrDefault();
                        if (itemImage != null)
                        {
                            var itemImageUrl = new Uri(itemImage.PicPath);
                            <!-- Image container on the right. Ensure it takes full width on mobile and can shrink. -->
                            <div class="w-full mt-8 md:mt-0 flex justify-center md:w-1/2 min-w-0">
                                <!-- Image styling: rounded corners, shadow, responsive width (max-w-full), auto height, border.
                                     Crucially, md:max-w-xs limits the image to a maximum of 320px on medium screens and larger,
                                     ensuring it doesn't get too big even if its container is larger. -->
                                <img src="@itemImageUrl" alt="@Model.AboutPage.PageTitle" class="rounded-xl shadow-lg max-w-full h-auto object-cover border-4 border-orange-200 md:max-w-xs">
                            </div>
                        }
                    }
                }
            </div>
        </div>
    </section>

    <section id="Contact" class="section-container bg-white py-8 px-4 sm:px-6 lg:px-8 rounded-xl shadow-lg">
        <div class="section-content max-w-4xl mx-auto">
            <!-- Flex container for image/form and text/map. Stacks vertically on small screens (flex-col) and becomes a row on medium screens and larger (md:flex-row). -->
            <div class="flex flex-col md:flex-row md:items-start md:space-x-8">
                <!-- Left column: Image and Contact Form -->
                <div class="md:w-1/2 mb-6 md:mb-0 flex flex-col items-center md:items-start">
                    @{
                        var itemCImages = Model.ContactPage.Posts.FirstOrDefault(x => x.PostType == "Contact");
                        if (itemCImages != null)
                        {
                            var itemImage = itemCImages.Pics.FirstOrDefault();
                            if (itemImage != null)
                            {
                                var itemImageUrl = new Uri(itemImage.PicPath);
                                <div class="mb-8 flex justify-center w-full">
                                    <img src="@itemImageUrl" alt="@Model.ContactPage.PageTitle" class="rounded-xl shadow-lg max-w-full h-auto object-cover border-4 border-orange-200 md:max-w-xs">
                                </div>
                            }
                        }
                    }
                    <form id="contactForm" action="/Newsletter/contact" method="POST" onsubmit="return handleContactFormSubmit(event)" class="contact-form space-y-4 w-full">
                        <div class="mb-4">
                            <label for="name" class="block text-gray-700 text-sm font-bold mb-2">Name:</label>
                            <input type="text" id="name" name="name" placeholder="Your Name" required class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
                        </div>
                        <div class="mb-4">
                            <label for="email" class="block text-gray-700 text-sm font-bold mb-2">Email:</label>
                            <input type="email" id="email" name="email" placeholder="your.email@example.com" required class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
                        </div>
                        <div class="mb-4">
                            <label for="message" class="block text-gray-700 text-sm font-bold mb-2">Message:</label>
                            <textarea id="message" name="message" placeholder="Your message..." rows="5" required class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline"></textarea>
                        </div>
                        <div class="mb-4">
                            <div class="g-recaptcha" data-sitekey="@Model.SiteKey" data-callback="recaptchaCompletedContact"></div>
                        </div>
                        <div class="mb-4">
                            <button type="submit" class="bg-orange-500 hover:bg-orange-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline transition duration-300">Send Message</button>
                        </div>
                    </form>
                </div>

                <!-- Right column: Text and Map -->
                <div class="md:w-1/2 mt-8 md:mt-0 flex flex-col items-center md:items-start">
                    <h2 class="text-3xl font-bold text-orange-700 mb-4 text-center md:text-left">@Model.ContactPage.PageTitle</h2>
                    <p class="text-lg leading-relaxed mb-6 text-gray-700 text-center md:text-left">
                        @Html.Raw(Model.ContactPage.Description)
                    </p>
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3150.813978901656!2d144.9741948766024!3d-37.84124053561007!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x823ea6e0e18d81f5%3A0xc3ac679f724a776d!2sDreamozTech!5e0!3m2!1sen!2sau!4v1774082213710!5m2!1sen!2sau"
                            width="100%"
                            height="300"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            class="contact-map rounded-xl shadow-lg mt-4"
                            title="DreamozTech Location on Google Maps"></iframe>
                </div>
            </div>
        </div>
    </section>

    <section id="Terms" class="section-container flex-col">
        <div class="section-content text-center md:text-left">
            <h2 class="text-3xl font-bold text-orange-700 mb-6 text-center">@Model.TermsPage.PageTitle</h2>
            <p class="text-lg leading-relaxed mb-4">
                @Html.Raw(Model.TermsPage.Description)
            </p>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="newsletter">
            <h2 class="text-3xl font-bold text-orange-700 mb-6 text-center">Subscribe to our emails</h2>
            <form id="newsletterForm" action="/Newsletter/subscribe" method="POST" onsubmit="handleSubscription(event)" class="space-y-4">
                <input type="text" id="nameInput" placeholder="Your Name" name="name" required />
                <input type="email" id="emailInput" placeholder="Email address" name="email" required />
                <div class="g-recaptcha" data-sitekey="@Model.SiteKey" data-callback="recaptchaCompleted"></div>
                <button type="submit" class="subscribe-button">Subscribe</button>
            </form>
        </div>
        <div class="social-icons">
            <a href="@Model.MemberDetailObject.FacebookProfile" target="_blank" aria-label="Facebook">
                <i class="fab fa-facebook-f"></i>
            </a>
            <a href="@Model.MemberDetailObject.InstagramProfile" target="_blank" aria-label="Instagram">
                <i class="fab fa-instagram"></i>
            </a>
        </div>
        <div class="copyright-content">
            &copy; @System.DateTime.Now.Year.ToString() @Model.MemberFullName
        </div>
    </footer>

    <!-- Popup Overlay -->
    <div class="popup-overlay" id="popup">
        <div class="popup flex flex-col items-center">
            <button class="close-btn" onclick="closePopup()">×</button>
            <img src="@Model.PopupPostImagePath" alt="@Model.PopupPost.BizName">
            <h2>@Model.PopupPost.MetaDesc</h2>
            <p>@Html.Raw(@Model.PopupPost.BizDesc)</p>
            <button class="popup-button" onclick="orderNowAndNavigate()">Order now</button>
        </div>
    </div>
    <div id="toast" class="toast"></div>
    <a href="#" id="scrollToTopBtn" title="Go to top">&#9650;</a>
</body>
</html>