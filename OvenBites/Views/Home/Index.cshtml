@model DisplayViewModel
@if (Model.CurrentPage != null)
{
    <section class="section-container">
        <div class="section-content">
            <h2>@Model.CurrentPage.PageTitle</h2>
            <p>@Html.Raw(Model.CurrentPage.Description)</p>
        </div>
    </section>
}
@if (Model.CurrentPost != null)
{
    <section class="section-container">
        <div class="section-content">
            <h2>@Model.CurrentPost.BizName</h2>
            <p>@Html.Raw(Model.CurrentPost.BizDesc)</p>
        </div>
    </section>
}