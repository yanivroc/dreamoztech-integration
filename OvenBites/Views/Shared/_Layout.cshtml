@model DisplayViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>@Model.MemberFullName</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Open+Sans&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>
    <header>
        <h1><a href="/"> <img src="@Model.MemberLogoImagePath" alt="@Model.MemberFullName" class="header-logo"></a></h1>
        <button class="hamburger-menu" aria-label="Open navigation menu">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </button>
        <nav id="mainNav">
            <button class="close-menu-btn" aria-label="Close menu">&times;</button>
            @foreach (var item in @Model.MenuItems)
            {
                <a href="#@item.Http">@item.Title</a>
            }
            <a href="" aria-label="Shopping Cart">
                <i class="fas fa-shopping-cart"></i>
                <span id="cart-item-count" class="cart-count">0</span>
            </a>
            <a href="@Model.MemberDetailObject.FacebookProfile" target="_blank" aria-label="Facebook">
                <i class="fab fa-facebook-f"></i>
            </a>
            <a href="@Model.MemberDetailObject.InstagramProfile" target="_blank" aria-label="Instagram">
                <i class="fab fa-instagram"></i>
            </a>
        </nav>
    </header>

    <section id="Home" class="hero-slider">
        <div class="slides-container">
            @{
                int slideIndex = 0;
                foreach (var pic in Model.SliderPics.OrderBy(p => p.DisplayOrder))
                {
                    <div class="slide @(slideIndex == 0 ? "active" : "")"
                         style="background-image: url('@(pic.PicPath)');">
                        <h2>@pic.PicDescription</h2>
                    </div>
                    slideIndex++;
                }
            }
        </div>
        <button class="prev-button">&#10094;</button>
        <button class="next-button">&#10095;</button>
        <div class="dots-container">
            @foreach (var pic in Model.SliderPics.OrderBy(p => p.DisplayOrder))
            {
                <span class="dot @(slideIndex == 0 ? "active" : "")" data-slide-index="@slideIndex"></span>
                slideIndex++;
            }
        </div>
    </section>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <!-- Main Content Area - Shopping Cart -->
    <main class="p-4 sm:p-6 lg:p-8 bg-gray-50 min-h-screen">
        <h1 class="text-3xl sm:text-4xl font-bold text-center text-gray-800 mb-8 custom-h1">Start Shopping Now!</h1>

        <!-- Cart Content Container -->
        <div id="cart-content-container" class="max-w-5xl mx-auto">
            <!-- Cart items table will be injected here by JavaScript -->
        </div>

        <!-- Summary and Checkout Section -->
        <div class="cart-summary-section">
            <!-- Centered summary -->
            <div class="summary-row">
                <span>Subtotal</span>
                <span id="subtotal-amount">$0.00</span>
            </div>
            <div class="summary-row delivery-option">
                <label for="delivery-checkbox">
                    Delivery
                    <input type="checkbox" id="delivery-checkbox">
                </label>
                <span id="delivery-amount" style="display: none;">$0.00</span>
            </div>
            <div class="summary-row total">
                <span>Total</span>
                <span id="total-amount">$0.00</span>
            </div>
            <div class="summary-action-buttons">
                <button type="button" class="btn btn-checkout custom-a" onclick="">Pay</button>
            </div>
        </div>
    </main>

    <section id="Cookies" class="products">
        @foreach (var item in Model.ProductList)
        {
            var itemPrice = item.Attributes.FirstOrDefault(x => x.Title == "price").Value;
            var itemImage = item.Pics.FirstOrDefault();
            var itemImageUrl = new Uri(itemImage.PicPath);
            <div class="product">
                <img src="@itemImageUrl" alt="@item.BizName">
                <h3><a href="/@item.BizDisplayTitle">@item.BizName</a></h3>
                <p class="item-price">@itemPrice</p>
                <button class="add-to-cart-btn w-full bg-green-500 text-white py-2 px-4 rounded-md hover:bg-green-600 transition duration-300" onclick="addToCart('@item.BizName', @itemPrice, '@item.BizDisplayTitle', '@itemImageUrl')">Add to Cart</button>
            </div>
        }
    </section>

    <section id="About" class="section-container">
        <div class="section-content">
            <h2 class="text-3xl font-bold text-orange-700 mb-4">@Model.AboutPage.PageTitle</h2>
            <p class="text-lg leading-relaxed mb-4">
                @Html.Raw(Model.AboutPage.Description)
            </p>
        </div>
    </section>

    <section id="Contact" class="section-container">
        <div class="section-content text-center md:text-left">
            <h2 class="text-3xl font-bold text-orange-700 mb-4">@Model.ContactPage.PageTitle</h2>
            <p class="text-lg leading-relaxed mb-6">
                @Html.Raw(Model.ContactPage.Description)
            </p>
            <form class="contact-form">
                <div class="mb-4">
                    <label for="name">Name:</label>
                    <input type="text" id="name" name="name" placeholder="Your Name" required>
                </div>
                <div class="mb-4">
                    <label for="email">Email:</label>
                    <input type="email" id="email" name="email" placeholder="your.email@example.com" required>
                </div>
                <div class="mb-4">
                    <label for="message">Message:</label>
                    <textarea id="message" name="message" placeholder="Your message..." rows="5" required></textarea>
                </div>
                <button type="submit">Send Message</button>
            </form>
        </div>
        <div class="section-content">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3151.835434509374!2d144.9537353153161!3d-37.8172097970799!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6ad642af0f11fd81%3A0xf577d6b3e9a9d7b!2sFederation%20Square!5e0!3m2!1sen!2sau!4v1678901234567!5m2!1sen!2sau"
                    width="100%"
                    height="300"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    class="contact-map"
                    title="Our Location on Google Maps"></iframe>
        </div>
    </section>

    <section id="Terms" class="section-container flex-col">
        <div class="section-content text-center md:text-left">
            <h2 class="text-3xl font-bold text-orange-700 mb-6 text-center">@Model.TermsPage.PageTitle</h2>
            <p class="text-lg leading-relaxed mb-4">
                @Html.Raw(Model.TermsPage.Description)
            </p>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="newsletter">
            <p>Subscribe to our emails</p>
            <form id="newsletterForm" action="/subscribe" method="POST" onsubmit="handleSubscription(event)">
                <input type="text" id="nameInput" placeholder="Your Name" name="name" required /> <input type="email" id="emailInput" placeholder="Email address" name="email" required />
                <button type="submit" class="subscribe-button">Subscribe</button>
            </form>
        </div>
        <div class="social-icons">
            <a href="@Model.MemberDetailObject.FacebookProfile" target="_blank" aria-label="Facebook">
                <i class="fab fa-facebook-f"></i>
            </a>
            <a href="@Model.MemberDetailObject.InstagramProfile" target="_blank" aria-label="Instagram">
                <i class="fab fa-instagram"></i>
            </a>
        </div>
        <div class="copyright-content">
            &copy; @System.DateTime.Now.Year.ToString() @Model.MemberFullName
        </div>
    </footer>

    <!-- Popup Overlay -->
    <div class="popup-overlay" id="popup">
        <div class="popup">
            <button class="close-btn" onclick="closePopup()">×</button>
            <img src="@Model.PopupPostImagePath" alt="@Model.PopupPost.BizName">
            <h2>@Model.PopupPost.MetaDesc</h2>
            <p>@Html.Raw(@Model.PopupPost.BizDesc)</p>
            <button class="popup-button" onclick="orderNowAndNavigate()">Order now</button>
        </div>
    </div>
    <div id="toast" class="toast"></div>
    <a href="#" id="scrollToTopBtn" title="Go to top">&#9650;</a>
    <script>
         // This function runs when the initial HTML document has been completely loaded and parsed.
         // It's ideal for setting up event listeners for elements that are present on the page load.
             document.addEventListener('DOMContentLoaded', function() {
             const hamburgerMenu = document.querySelector('.hamburger-menu'); // Renamed to hamburgerMenu for clarity
             const nav = document.getElementById('mainNav'); // Use the ID we added, renamed to nav for consistency
             const closeMenuBtn = document.querySelector('.close-menu-btn'); // Select the new close button
             const body = document.body; // Reference to the body element


             // Function to toggle menu state
             function toggleMenu() {
                 if (nav) {
                     nav.classList.toggle('active'); // Toggles the 'active' class on the nav
                 }
                 if (hamburgerMenu) {
                     hamburgerMenu.classList.toggle('active'); // Optional: Add active state to hamburger for animation
                 }
                 body.classList.toggle('menu-open'); // Toggles a class on the body to control overflow/overlay
             }

             // Event listener for the hamburger menu to OPEN the menu
             if (hamburgerMenu && nav) { // Ensure both elements exist
                 hamburgerMenu.addEventListener('click', toggleMenu);
             }

             // Event listener for the new close button to CLOSE the menu
             if (closeMenuBtn && nav) { // Ensure both elements exist
                 closeMenuBtn.addEventListener('click', toggleMenu);
             }

             // Optional: Close menu when a link inside it is clicked (for single-page navigation)
             if (nav) {
                 // Exclude the close button itself from this listener
                 nav.querySelectorAll('a:not(.close-menu-btn)').forEach(link => {
                     link.addEventListener('click', () => {
                         // Only close if the menu is currently open
                         if (nav.classList.contains('active')) {
                             toggleMenu();
                         }
                     });
                 });
             }

             // Optional: Close menu if user clicks outside the menu when it's open
             document.addEventListener('click', function(event) {
                 // Check if the nav is active (open) AND the click target is NOT inside the nav
                 // AND the click target is NOT the hamburger menu button itself.
                 if (nav && nav.classList.contains('active') &&
                     !nav.contains(event.target) &&
                     !hamburgerMenu.contains(event.target)) {
                     toggleMenu();
                 }
             });


             // --- Slider functionality (no changes needed here for the close button) ---
             const slidesContainer = document.querySelector('.slides-container');
             const slides = document.querySelectorAll('.slide');
             const prevButton = document.querySelector('.prev-button');
             const nextButton = document.querySelector('.next-button');
             const dotsContainer = document.querySelector('.dots-container');
             const dots = document.querySelectorAll('.dot'); // Make sure your HTML has elements with class 'dot'

             let currentIndex = 0;
             const totalSlides = slides.length;

             function updateSlider() {
                 slidesContainer.style.transform = `translateX(-${currentIndex * 100}%)`;
                 updateDots();
             }

             function updateDots() {
                 dots.forEach((dot, index) => {
                     if (index === currentIndex) {
                         dot.classList.add('active');
                     } else {
                         dot.classList.remove('active');
                     }
                 });
             }

             if (nextButton) {
                 nextButton.addEventListener('click', () => {
                     currentIndex = (currentIndex + 1) % totalSlides;
                     updateSlider();
                 });
             }

             if (prevButton) {
                 prevButton.addEventListener('click', () => {
                     currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
                     updateSlider();
                 });
             }

             if (dotsContainer) { // Check if dotsContainer exists before adding listeners to dots
                 dots.forEach(dot => {
                     dot.addEventListener('click', (event) => {
                         const slideIndex = parseInt(event.target.dataset.slideIndex);
                         currentIndex = slideIndex;
                         updateSlider();
                     });
                 });
             }

             // Optional: Auto-slide
             // Ensure you pause this if user interacts with buttons for better UX
             if (totalSlides > 1) { // Only auto-slide if there's more than one slide
                 setInterval(() => {
                     currentIndex = (currentIndex + 1) % totalSlides;
                     updateSlider();
                 }, 5000); // Change slide every 5 seconds
             }

             // Initialize the slider state
             if (slidesContainer) {
                 updateSlider();
             }
         });
         // --- End of DOMContentLoaded block ---


             // Global reference for the popup element, initialized once DOM is ready
         let popupOverlayElement;

         /**
          * Attempts to show the popup if it hasn't been shown in the current session.
          * Sets a sessionStorage flag if it shows the popup.
          */
         function showPopupIfNeverShown() {
             // Lazy-initialize popupOverlayElement if not already set
             if (!popupOverlayElement) {
                 popupOverlayElement = document.getElementById("popup");
                 if (!popupOverlayElement) { // If element doesn't exist, do nothing
                     console.warn("Popup element with ID 'popup' not found.");
                     return;
                 }
             }

             const hasPopupBeenShown = sessionStorage.getItem('hasPopupBeenShown');

             if (!hasPopupBeenShown) {
                 popupOverlayElement.style.display = "flex"; // Show the popup
                 sessionStorage.setItem('hasPopupBeenShown', 'true'); // Mark as shown for this session
                 console.log("Popup shown for the first time this session.");
             } else {
                 console.log("Popup already shown this session, skipping.");
             }
         }

         /**
          * Closes the popup. This also ensures the sessionStorage flag is set
          * so it doesn't reappear via exit-intent if closed manually.
          */
         function closePopup() {
             // Lazy-initialize popupOverlayElement if not already set
             if (!popupOverlayElement) {
                 popupOverlayElement = document.getElementById("popup");
                 if (!popupOverlayElement) return;
             }

             popupOverlayElement.style.display = "none";
             // Ensure flag is set, even if manually closed, to prevent exit-intent re-trigger
             sessionStorage.setItem('hasPopupBeenShown', 'true');
             console.log("Popup closed by user.");
         }

         // --- MAIN POPUP LOGIC INITIALIZATION ---

         // 1. Show popup on initial page load (once per session)
         window.onload = function() {
             console.log("Window loaded. Checking popup status...");
             showPopupIfNeverShown();
         };

         // Close popup and navigate to #products (assuming 'cookies' was a typo and you meant products)
         function orderNowAndNavigate() {
             closePopup();
             // Corrected target ID to 'products' which is a more common section name.
             // If your actual section ID is 'cookies', change this back to '#cookies'.
             window.location.href = '#Cookies';
         }

                 // Get the button
            const scrollToTopBtn = document.getElementById("scrollToTopBtn");

            // When the user scrolls down 20px from the top of the document, show the button
            window.onscroll = function() {
                if (document.body.scrollTop > 30 || document.documentElement.scrollTop > 30) {
                    scrollToTopBtn.style.display = "block";
                } else {
                    scrollToTopBtn.style.display = "none";
                }
            };

            // When the user clicks on the button, scroll to the top of the document
            scrollToTopBtn.onclick = function() {
                document.body.scrollTop = 0; // For Safari
                document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
            };

         // NEW FUNCTION: Handle form submission with AJAX after browser validation
         async function handleSubscription(event) {
             event.preventDefault(); // Prevent the default form submission

             const nameInput = document.getElementById('nameInput'); // Get the name input
             const emailInput = document.getElementById('emailInput');

             const nameValue = nameInput ? nameInput.value.trim() : ''; // Get name, handle if input doesn't exist
             const emailValue = emailInput.value.trim();

             // **Important:** At this point, the browser has already validated the email field
             // because of type="email" and required attributes on the input.

             // Perform the AJAX request
             try {
                 // Replace '/subscribe' with your actual server endpoint for subscription
                 const response = await fetch('/subscribe', {
                     method: 'POST',
                     headers: {
                         'Content-Type': 'application/json',
                         'Accept': 'application/json'
                     },
                     // Include both name and email in the request body
                     body: JSON.stringify({
                         name: nameValue,
                         email: emailValue
                     }),
                 });

                 if (!response.ok) {
                     const errorData = await response.json();
                     throw new Error(errorData.message || `HTTP error! status: ${response.status}`);
                 }

                 const data = await response.json();

                 console.log('Subscription Success:', data);
                 alert('Thank you for subscribing, ' + (nameValue || '!') + ' We will send you updates!');

                 // Clear both input fields after successful subscription
                 if (nameInput) nameInput.value = '';
                 emailInput.value = '';

             } catch (error) {
                 console.error('Subscription Error:', error);
                 alert('There was an error subscribing: ' + error.message + '. Please try again later.');
             }
         }

         // Helper function to show the toast message
         function showToast(message) {
             const toast = document.getElementById("toast");
             toast.textContent = message;
             toast.classList.add("show");

             // Hide the toast after 3 seconds
             setTimeout(function(){
                 toast.classList.remove("show");
             }, 3000); // 3000 milliseconds = 3 seconds
         }





         // You'll also need these helper functions and the storage key defined:
         const CART_STORAGE_KEY = 'shoppingCartSession'; // Or 'shoppingCart' if you prefer localStorage
         console.log("Cart page script loaded."); // Added for debugging

        // Get references to DOM elements
        const cartContentDiv = document.getElementById('cart-content-container'); // Updated to target the new container
        const subtotalAmountSpan = document.getElementById('subtotal-amount');
        const totalAmountSpan = document.getElementById('total-amount');
        const countdownTimerSpan = document.getElementById('countdown-timer');
        const cartItemCountSpan = document.getElementById('cart-item-count'); // From navigation
        const deliveryCheckbox = document.getElementById('delivery-checkbox');
        const deliveryAmountSpan = document.getElementById('delivery-amount');

        // Add this new function to update the cart count display
         function updateCartCount() {
             const cart = getCartItems();
             const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
             const cartCountElement = document.getElementById('cart-item-count');

             if (cartCountElement) {
                 cartCountElement.textContent = totalItems;
                 // Optionally hide the count if it's zero
                 if (totalItems === 0) {
                     cartCountElement.style.display = 'none';
                 } else {
                     cartCountElement.style.display = 'inline-block'; // Or whatever your CSS sets it to
                 }
             }
         }

         // add to cart
         function addToCart(itemName, itemPrice, itemPath, itemImageUrl) {
             let cart = getCartItems();
             const existingItem = cart.find(item => item.itemPath === itemPath);

             if (existingItem) {
                 if (existingItem.quantity < 6) {
                     existingItem.quantity++;
                     showToast(`${itemName} added to cart!`); // Call the showToast function
                 } else {
                     console.log(`Maximum quantity (6) reached for ${itemName}.`);
                     showToast(`Maximum quantity (6) reached for ${itemName}.`); // Show toast for max quantity
                 }
             } else {
                 cart.push({
                     name: itemName,
                     price: itemPrice,
                     itemPath: itemPath,
                     quantity: 1,
                     imagePath: itemImageUrl
                 });
                 showToast(`${itemName} added to cart!`); // Call the showToast function
             }

             saveCartItems(cart);
             console.log('Current Cart:', getCartItems());
             updateCartCount();
             renderCart();
         }

        /**
         * Retrieves the current cart items from sessionStorage.
         */
        function getCartItems() {
            try {
                const cartJson = localStorage.getItem(CART_STORAGE_KEY);
                return cartJson ? JSON.parse(cartJson) : [];
            } catch (e) {
                console.error("Error parsing cart from sessionStorage:", e);
                return [];
            }
        }

        /**
         * Saves the given cart items to sessionStorage.
         */
        function saveCartItems(cart) {
            try {
                localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart));
            } catch (e) {
                console.error("Error saving cart to sessionStorage:", e);
            }
        }

        /**
         * Updates the total item count displayed on the cart icon.
         */
        function updateCartCount() {
            const cart = getCartItems();
            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            console.log("totalItems", totalItems, cartItemCountSpan);
            if (cartItemCountSpan) {
                cartItemCountSpan.textContent = totalItems;
                if (totalItems > 0) {
                    cartItemCountSpan.classList.remove('hidden');
                } else {
                    cartItemCountSpan.classList.add('hidden');
                }
            }
        }

        /**
         * Updates the quantity of a specific item in the cart.
         */
        function updateQuantity(itemPath, newQuantity) {
            let cart = getCartItems();
            cart = cart.map(item => {
                if (item.itemPath === itemPath) {
                    const quantity = Math.max(1, Math.min(6, newQuantity));
                    return { ...item, quantity };
                }
                return item;
            }).filter(item => item.quantity > 0);

            saveCartItems(cart);
            updateCartCount();
            renderCart();
        }

        /**
         * Removes an item from the cart.
         */
        function removeItem(itemPath) {
            let cart = getCartItems();
            cart = cart.filter(item => item.itemPath !== itemPath);
            saveCartItems(cart);
            updateCartCount();
            renderCart();
        }

        /**
         * Displays a custom message box instead of alert().
         */
        function showMessageBox(message) {
            const overlay = document.createElement('div');
            overlay.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
            overlay.id = 'message-box-overlay';

            const messageBox = document.createElement('div');
            messageBox.className = 'bg-white p-6 rounded-lg shadow-xl max-w-sm w-full text-center';
            messageBox.innerHTML = `
                <p class="text-lg font-semibold text-gray-800 mb-4">${message}</p>
                <button id="messageBoxCloseBtn" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-4 rounded-md transition duration-300">
                    OK
                </button>
            `;

            overlay.appendChild(messageBox);
            document.body.appendChild(overlay);

            document.getElementById('messageBoxCloseBtn').addEventListener('click', () => {
                document.body.removeChild(overlay);
            });
        }


            // Define your delivery cost here
            let DELIVERY_COST = 0.00; // Example delivery cost
            function renderCart() {
            const cart = getCartItems();  // Retrieve cart items from sessionStorage
            let subtotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
            //add delivery
            if (deliveryCheckbox.checked) {
                let totalQuantity = cart.reduce((sum, item) => sum + item.quantity, 0);
                if(totalQuantity < 6)
                {
                    DELIVERY_COST = 9.99;
                }
                if(totalQuantity > 6 && totalQuantity < 12)
                {
                    DELIVERY_COST = 12.99;
                }
                deliveryAmountSpan.textContent = `$${DELIVERY_COST.toFixed(2)}`;
                deliveryAmountSpan.style.display = 'inline'; // Show the delivery amount
            } else {
                deliveryAmountSpan.style.display = 'none'; // Hide the delivery amount
            }
            let total = DELIVERY_COST + subtotal;

            let cartContentHtml = '';
            if (cart.length === 0) {
                cartContentHtml = '<h2 class="text-center text-gray-600 text-lg custom-h1">Your cart is empty.</h2>';
            } else {
                cartContentHtml = `
                            <table class="cart-table">
                                <thead>
                                    <tr>
                                        <th class="w-2/5">Product</th>
                                        <th class="w-1/5">Price</th>
                                        <th class="w-1/5">Quantity</th>
                                        <th class="w-1/5 text-right">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${cart.map(item => `
                                        <tr>
                                            <td class="product-col" data-label="Product">
                                                <img
                                                    src="${item.imagePath}"
                                                    alt="${item.name}"
                                                    class="w-20 h-20 object-cover rounded-md flex-shrink-0"
                                                    onerror="this.onerror=null; this.src='https://placehold.co/80x80/CCCCCC/000000?text=No+Image';"
                                                />
                                                <div>
                                                    <h3 class="text-lg font-semibold text-gray-900">${item.name}</h3>
                                                </div>
                                            </td>
                                            <td data-label="Price">
                                                <p class="text-gray-800 font-medium">$${item.price.toFixed(2)}</p>
                                            </td>
                                            <td data-label="Quantity">
                                                <div class="flex items-center space-x-2">
                                                    <div class="quantity-controls">
                                                        <button
                                                            data-item-path="${item.itemPath}"
                                                            data-action="decrease"
                                                            ${item.quantity <= 1 ? 'disabled' : ''}
                                                            class="quantity-btn"
                                                        >
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-minus"><path d="M5 12h14"/></svg>
                                                        </button>
                                                        <span class="text-lg font-medium text-gray-800 text-center">
                                                            ${item.quantity}
                                                        </span>
                                                        <button
                                                            data-item-path="${item.itemPath}"
                                                            data-action="increase"
                                                            ${item.quantity >= 6 ? 'disabled' : ''}
                                                            class="quantity-btn"
                                                        >
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                                                        </button>
                                                        <button
                                                            data-item-path="${item.itemPath}"
                                                            class="remove-item-btn"
                                                            data-label="Remove"
                                                        >
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-circle"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
                                                        </button>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-right" data-label="Total">
                                                <p class="text-lg font-semibold text-indigo-600">$${(item.price * item.quantity).toFixed(2)}</p>
                                            </td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                `;
            }

            cartContentDiv.innerHTML = cartContentHtml;

            // Update subtotal and total amounts
            if (subtotalAmountSpan) subtotalAmountSpan.textContent = `$${subtotal.toFixed(2)}`;
            if (totalAmountSpan) totalAmountSpan.textContent = `$${total.toFixed(2)}`;

            // Re-attach event listeners for dynamically added elements
            document.querySelectorAll('.quantity-btn').forEach(button => {
                button.addEventListener('click', (event) => {
                    const itemPath = event.currentTarget.dataset.itemPath;
                    const action = event.currentTarget.dataset.action;
                    let currentQuantity = parseInt(event.currentTarget.closest('.quantity-controls').querySelector('span').textContent);
                    updateQuantity(itemPath, currentQuantity + (action === 'increase' ? 1 : -1));
                });
            });

            document.querySelectorAll('.remove-item-btn').forEach(button => {
                button.addEventListener('click', (event) => {
                    const itemPath = event.currentTarget.dataset.itemPath;
                    removeItem(itemPath);
                });
            });
        }

        // Ensure cart is rendered when the page loads
        document.addEventListener('DOMContentLoaded', () => {
            renderCart();
            updateCartCount();
            // Event listener for the delivery checkbox
            if (deliveryCheckbox) {
                deliveryCheckbox.addEventListener('change', renderCart);
            }
        });
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
