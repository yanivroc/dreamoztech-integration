@using Newtonsoft.Json
@using OvenBites.Api
@{
    var domainPath = "https://dreamoztech.com/";
    var productJson = ViewData["Product"] as string;
    var memberJson = ViewData["Member"] as string;
    var postJson = ViewData["Post"] as string;
    var webJson = ViewData["Web"] as string;
    //member
    var rootObject = JsonConvert.DeserializeObject<ResponseViewModel>(memberJson);
    var memberDetailObject = rootObject?.Member;
    var memberFullName = memberDetailObject.MemberFullName.Replace(" ", "");
    var memberLogoImagePath = new Uri(domainPath + memberDetailObject.ProfilePicture);
    //web
    var webDetailObject = JsonConvert.DeserializeObject<ResponseViewModel>(webJson);
    var web = webDetailObject.Webs.FirstOrDefault();
    List<MenuItemModel> menuItems = JsonConvert.DeserializeObject<List<MenuItemModel>>(web.MenuItems);
    var cookiesPage = web.WebPages.FirstOrDefault(x => x.PagePath == "about");
    var aboutPage = web.WebPages.FirstOrDefault(x => x.PagePath == "about");
    //var aboutPagepost = aboutPage.Posts.FirstOrDefault();
    var contactPage = web.WebPages.FirstOrDefault(x => x.PagePath == "about");
    var termsPage = web.WebPages.FirstOrDefault(x => x.PagePath == "about");
    //post
    var postDetailObject = JsonConvert.DeserializeObject<ResponseViewModel>(postJson);
    var sliderPost = postDetailObject.Posts.FirstOrDefault(x => x.BizDisplayTitle == "Slider-Ovenbites");
    var popupPost = postDetailObject.Posts.FirstOrDefault(x => x.BizDisplayTitle == "Popup-Ovenbites");
    List<PicDto> sliderPics = sliderPost.Pics.ToList();
    //product
    var productDetailObject = JsonConvert.DeserializeObject<ResponseViewModel>(productJson);
    var productList = productDetailObject.Products.Posts.ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@memberFullName</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Open+Sans&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>
    <header>
        <h1><img src="@memberLogoImagePath" alt="@memberFullName" class="header-logo"></h1>
        <nav>
            @foreach (var item in menuItems)
            {
                <a href="#@item.Http">@item.Title</a>
            }
            <a href="@memberDetailObject.FacebookProfile" target="_blank" aria-label="Facebook">
                <i class="fab fa-facebook-f"></i>
            </a>
            <a href="@memberDetailObject.InstagramProfile" target="_blank" aria-label="Instagram">
                <i class="fab fa-instagram"></i>
            </a>
        </nav>
    </header>

    <section id="Home" class="hero-slider">
        <div class="slides-container">
            @{
                int slideIndex = 0;
                foreach (var pic in sliderPics.OrderBy(p => p.DisplayOrder))
                {
                    <div class="slide @(slideIndex == 0 ? "active" : "")"
                    style="background-image: url('@(pic.PicPath)');">
                        @* Prepend domainPath for full URL *@
                        <h2>@pic.PicDescription</h2>
                    </div>
                    slideIndex++;
                }
            }
        </div>
        <button class="prev-button">&#10094;</button>
        <button class="next-button">&#10095;</button>
        <div class="dots-container">
            @foreach (var pic in sliderPics.OrderBy(p => p.DisplayOrder)) // Loop through the same data
            {
                <span class="dot @(slideIndex == 0 ? "active" : "")" data-slide-index="@slideIndex"></span>
                slideIndex++;
            }
        </div>
    </section>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <section id="Cookies" class="products">
        @foreach (var item in productList)
        {
            var itemPrice = item.Attributes.FirstOrDefault(x=>x.Title == "price").Value;
            var itemImage = item.Pics.FirstOrDefault();
            var itemImageUrl = new Uri(itemImage.PicPath);
            <div class="product">
                <img src="@itemImageUrl" alt="@item.BizName">
                <h3>@item.BizName</h3>
                <p class="item-price">@itemPrice</p>
                <button class="add-to-cart-btn w-full bg-green-500 text-white py-2 px-4 rounded-md hover:bg-green-600 transition duration-300">Add to Cart</button>
            </div>
        }
    </section>

    <!-- About Us Section -->
    <section id="About" class="section-container">
        <div class="section-content text-center md:text-left">
            <img src="https://placehold.co/500x350/b45f06/ffffff?text=About+Us+Image" alt="About Us" class="about-us-image mx-auto md:mx-0">
        </div>
        <div class="section-content">
            <h2 class="text-3xl font-bold text-orange-700 mb-4">About Our Company</h2>
            <p class="text-lg leading-relaxed mb-4">
                Welcome to our passion project! We started this journey with a simple goal: to bring high-quality, ethically sourced products directly to your doorstep. Our commitment lies in offering a curated selection that not only meets your needs but also delights your senses.
            </p>
            <p class="text-lg leading-relaxed">
                Every item in our collection is chosen with care, ensuring it meets our rigorous standards for quality, sustainability, and uniqueness. We believe in building lasting relationships with our customers by providing exceptional products and unparalleled service. Thank you for being a part of our story!
            </p>
        </div>
    </section>

    <!-- Contact Us Section -->
    <section id="Contact" class="section-container">
        <div class="section-content text-center md:text-left">
            <h2 class="text-3xl font-bold text-orange-700 mb-4">Get in Touch</h2>
            <p class="text-lg leading-relaxed mb-6">
                Have questions, feedback, or just want to say hello? We'd love to hear from you! Fill out the form below, and we'll get back to you as soon as possible.
            </p>
            <form class="contact-form">
                <div class="mb-4">
                    <label for="name">Name:</label>
                    <input type="text" id="name" name="name" placeholder="Your Name" required>
                </div>
                <div class="mb-4">
                    <label for="email">Email:</label>
                    <input type="email" id="email" name="email" placeholder="your.email@example.com" required>
                </div>
                <div class="mb-4">
                    <label for="message">Message:</label>
                    <textarea id="message" name="message" placeholder="Your message..." rows="5" required></textarea>
                </div>
                <button type="submit">Send Message</button>
            </form>
        </div>
        <div class="section-content">
            <!-- Google Maps Embed - Replace with your actual location -->
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3151.835434509374!2d144.9537353153161!3d-37.8172097970799!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6ad642af0f11fd81%3A0xf577d6b3e9a9d7b!2sFederation%20Square!5e0!3m2!1sen!2sau!4v1678901234567!5m2!1sen!2sau"
                    width="100%"
                    height="300"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    class="contact-map"
                    title="Our Location on Google Maps"></iframe>
        </div>
    </section>

    <!-- Terms and Conditions Section -->
    <section id="Terms" class="section-container flex-col">
        <h2 class="text-3xl font-bold text-orange-700 mb-6 text-center">Terms and Conditions</h2>
        <div class="section-content text-left">
            <h3 class="text-2xl font-semibold text-orange-600 mb-3">1. Acceptance of Terms</h3>
            <p class="text-lg leading-relaxed mb-4">
                By accessing and using this website, you accept and agree to be bound by the terms and provisions of this agreement. In addition, when using these particular services, you shall be subject to any posted guidelines or rules applicable to such services, which may be posted and modified from time to time. All such guidelines or rules are hereby incorporated by reference into the Terms and Conditions.
            </p>

            <h3 class="text-2xl font-semibold text-orange-600 mb-3">2. Intellectual Property</h3>
            <p class="text-lg leading-relaxed mb-4">
                The content, organization, graphics, design, compilation, magnetic translation, digital conversion, and other matters related to the Site are protected under applicable copyrights, trademarks, and other proprietary (including but not limited to intellectual property) rights. The copying, redistribution, use, or publication by you of any such matters or any part of the Site is strictly prohibited.
            </p>

            <h3 class="text-2xl font-semibold text-orange-600 mb-3">3. User Conduct</h3>
            <p class="text-lg leading-relaxed mb-4">
                You agree to use the Site only for lawful purposes and in a way that does not infringe the rights of, restrict or inhibit anyone else's use and enjoyment of the Site. Prohibited behavior includes harassing or causing distress or inconvenience to any other user, transmitting obscene or offensive content, or disrupting the normal flow of dialogue within the Site.
            </p>

            <h3 class="text-2xl font-semibold text-orange-600 mb-3">4. Disclaimer of Warranties</h3>
            <p class="text-lg leading-relaxed mb-4">
                The Site and its content are provided "as is" without any representations or warranties of any kind, either express or implied, including but not limited to, the implied warranties of merchantability, fitness for a particular purpose, or non-infringement.
            </p>

            <h3 class="text-2xl font-semibold text-orange-600 mb-3">5. Limitation of Liability</h3>
            <p class="text-lg leading-relaxed mb-4">
                In no event will the Company be liable for any damages whatsoever, including, without limitation, direct, indirect, incidental, special, consequential, or punitive damages, arising out of or in connection with your use of the Site or any content on the Site.
            </p>

            <h3 class="text-2xl font-semibold text-orange-600 mb-3">6. Changes to Terms</h3>
            <p class="text-lg leading-relaxed mb-4">
                We reserve the right to change these Terms and Conditions at any time. Your continued use of the Site following any changes indicates your acceptance of the new Terms and Conditions.
            </p>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="newsletter">
            <p>Subscribe to our emails</p>
            <input type="email" placeholder="Email address" />
        </div>
        <div class="social-icons">
            <a href="@memberDetailObject.FacebookProfile" target="_blank" aria-label="Facebook">
                <i class="fab fa-facebook-f"></i>
            </a>
            <a href="@memberDetailObject.InstagramProfile" target="_blank" aria-label="Instagram">
                <i class="fab fa-instagram"></i>
            </a>
        </div>
        <div class="copyright-content">
            &copy; @System.DateTime.Now.Year.ToString() @memberFullName
        </div>
    </footer>

    <!-- Popup Overlay -->
    <div class="popup-overlay" id="popup">
        <div class="popup">
            <button class="close-btn" onclick="closePopup()">×</button>
            <img src="oven-bites-03.jpg" alt="Flavor of the Month">
            <h2>Flavor of the Month!</h2>
            <p>Try our limited-edition cookie:<br><strong>HABIBI NUTELLA DUBAI 🍪🤎</strong></p>
            <button class="popup-button">Order now</button>
            <p>Only available this month. Limited edition!</p>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
          const slidesContainer = document.querySelector('.slides-container');
          const slides = document.querySelectorAll('.slide');
          const prevButton = document.querySelector('.prev-button');
          const nextButton = document.querySelector('.next-button');
          const dotsContainer = document.querySelector('.dots-container');
          const dots = document.querySelectorAll('.dot');

          let currentIndex = 0;
          const totalSlides = slides.length;

          function updateSlider() {
            slidesContainer.style.transform = `translateX(-${currentIndex * 100}%)`;
            updateDots();
          }

          function updateDots() {
            dots.forEach((dot, index) => {
              if (index === currentIndex) {
                dot.classList.add('active');
              } else {
                dot.classList.remove('active');
              }
            });
          }

          nextButton.addEventListener('click', () => {
            currentIndex = (currentIndex + 1) % totalSlides;
            updateSlider();
          });

          prevButton.addEventListener('click', () => {
            currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
            updateSlider();
          });

          dots.forEach(dot => {
            dot.addEventListener('click', (event) => {
              const slideIndex = parseInt(event.target.dataset.slideIndex);
              currentIndex = slideIndex;
              updateSlider();
            });
          });

          // Optional: Auto-slide
          setInterval(() => {
            currentIndex = (currentIndex + 1) % totalSlides;
            updateSlider();
          }, 5000); // Change slide every 5 seconds

          // Initialize the slider
          updateSlider();
        });

        // Show popup on load
        window.onload = function() {
          document.getElementById("popup").style.display = "flex";
        };

        // Close popup
        function closePopup() {
          document.getElementById("popup").style.display = "none";
        }
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
